{
  "name": "Diabetic Ketoacidosis Presentation",
  "remarks": [
    "Synthea Generic Module for emergency presentation of diabetic ketoacidosis",
    "Incorporates high anion gap metabolic acidosis, arterial blood gas pH, beta-hydroxybutyrate, and guideline-directed fluid/insulin resuscitation"
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "DKA_Risk_Assessment"
