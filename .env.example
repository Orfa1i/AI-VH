# AI Virtual Hospital (AI-VH) Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials or .env files to version control.

# Server & Environment
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
SECRET_KEY=insecure-dev-secret-key-change-in-production

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./hospital.db
POSTGRES_USER=ai_vh
POSTGRES_PASSWORD=ai_vh_secret
POSTGRES_DB=ai_vh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local Model Weights & RAG Vector Stores
MEDGEMMA_MODEL_PATH=./MedGemma Model/model
DPO_ADAPTER_PATH=./models/medgemma-dpo-lora
HARRISON_VECTOR_DB_PATH=./data/knowledge/harrison_chroma

# Thresholds Configuration Path
THRESHOLDS_PATH=./configs/thresholds.yaml

# CORS & Networking
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Logging & Telemetry
LOG_LEVEL=INFO
